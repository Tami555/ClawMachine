--- !u!114 &424872884
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 424872882}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5cb5dd2ee2d2c314f8c43ba580255584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HintsController
  cards:
  - cardObject: {fileID: 0}
    title: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!"
    body: "\u0426\u0435\u043B\u044C \u0438\u0433\u0440\u044B \u2014 \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u0438\u0433\u0440\u0443\u0448\u043A\u0443\r\n\r\n\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u0430\u043C\u0435\u0440\u043E\u0439:\r\n\u2022 \u0417\u0430\u0436\u043C\u0438 \u043F\u0440\u0430\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0438 \u0432\u043E\u0434\u0438 \u043C\u044B\u0448\u043A\u043E\u0439 \u2014 \u043E\u0431\u0437\u043E\u0440 \u0432\u043E\u043A\u0440\u0443\u0433 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430\r\n\u2022 \u041A\u043E\u043B\u0451\u0441\u0438\u043A\u043E \u043C\u044B\u0448\u0438 \u2014 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0435/\u043E\u0442\u0434\u0430\u043B\u0435\u043D\u0438\u0435"
  - cardObject: {fileID: 0}
    title: "\u041A\u0430\u043A \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0431\u0430\u043B\u0430\u043D\u0441"
    body: "1. \u041D\u0430\u0436\u043C\u0438 Tab \u2014 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043A\u043E\u0448\u0435\u043B\u0451\u043A\r\n2. \u041D\u0430\u0436\u043C\u0438 Tab \u0435\u0449\u0451 \u0440\u0430\u0437 \u2014 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043A\u0443\u043F\u044E\u0440\u0430 \u0432 5$\r\n3. \u041D\u0430\u0436\u043C\u0438 \u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u043A\u0443\u043F\u044E\u0440\u0430 \u0443\u0439\u0434\u0451\u0442 \u0432 \u0430\u0432\u0442\u043E\u043C\u0430\u0442, \u0431\u0430\u043B\u0430\u043D\u0441 +5$\r\n4. \u041F\u043E\u0434\u043E\u0436\u0434\u0438 1 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u2014 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043D\u043E\u0432\u0430\u044F \u043A\u0443\u043F\u044E\u0440\u0430\n\r5. \u041D\u0430\u0436\u043C\u0438 Tab \u0442\u0440\u0435\u0442\u0438\u0439 \u0440\u0430\u0437 \u2014 \u0443\u0431\u0435\u0440\u0438 \u043A\u0443\u043F\u044E\u0440\u0443\r\n\r\n\u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043E\u0434\u043D\u043E\u0439 \u0438\u0433\u0440\u044B \u2014 10$."
  - cardObject: {fileID: 0}
    title: "\u041A\u0430\u043A \u043D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443"
    body: "1. \u0423\u0431\u0435\u0434\u0438\u0441\u044C, \u0447\u0442\u043E \u0432 \u0440\u0443\u043A\u0435 \u041D\u0415\u0422 \u043A\u0443\u043F\u044E\u0440\u044B (Tab \u0443\u0431\u0438\u0440\u0430\u0435\u0442)\r\n2. \u041D\u0430\u0439\u0434\u0438 \u041A\u0420\u0410\u0421\u041D\u0423\u042E \u041A\u041D\u041E\u041F\u041A\u0423 \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430\r\n3. \u041A\u043B\u0438\u043A\u043D\u0438 \u043F\u043E \u043D\u0435\u0439 \u043B\u0435\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438\r\n4. \u0415\u0441\u043B\u0438 \u0434\u0435\u043D\u0435\u0433 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u2014 \u043D\u0430 \u0442\u0430\u0439\u043C\u0435\u0440\u0435 \u043D\u0430\u0447\u043D\u0435\u0442\u0441\u044F \u043E\u0431\u0440\u0430\u0442\u043D\u044B\u0439 \u043E\u0442\u0441\u0447\u0435\u0442 \u0432 35 \u0441\u0435\u043A\u0443\u043D\u0434\r\n\r\n\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435: \u0443 \u0442\u0435\u0431\u044F \u0442\u043E\u043B\u044C\u043A\u043E 1 \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0437\u0430 \u0438\u0433\u0440\u0443!"
  - cardObject: {fileID: 0}
    title: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u043C"
    body: "\u0421\u0442\u0440\u0435\u043B\u043A\u0438 \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043A\u043B\u0435\u0448\u043D\u0438:\r\n\u2022 \u2190 \u0432\u043B\u0435\u0432\u043E\r\n\u2022 \u2192 \u0432\u043F\u0440\u0430\u0432\u043E\r\n\u2022 \u2191 \u0432\u043F\u0435\u0440\u0451\u0434 (\u0432\u0433\u043B\u0443\u0431\u044C)\r\n\u2022 \u2193 \u043D\u0430\u0437\u0430\u0434 (\u043A \u0441\u0435\u0431\u0435)\r\n\r\n\u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043A\u043B\u0435\u0448\u043D\u044E.\r\n\u041F\u0440\u043E\u0431\u0435\u043B \u043F\u043E\u0441\u043B\u0435 \u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u044F \u2014 \u0437\u0430\u0445\u0432\u0430\u0442.\r\n\r\n\u041F\u043E\u0439\u043C\u0430\u043B \u0438\u0433\u0440\u0443\u0448\u043A\u0443 \u2014 \u043A\u0440\u0430\u043D \u0441\u0430\u043C \u043F\u043E\u043D\u0435\u0441\u0451\u0442 \u0435\u0451 \u043A \u043A\u043E\u0440\u0437\u0438\u043D\u0435."
  - cardObject: {fileID: 0}
    title: "\u041F\u043E\u0431\u0435\u0434\u0430"
    body: "\u0415\u0441\u043B\u0438 \u0438\u0433\u0440\u0443\u0448\u043A\u0430 \u043F\u043E\u043F\u0430\u043B\u0430 \u0432 \u043A\u043E\u0440\u0437\u0438\u043D\u0443 \u2014 \u0442\u044B \u0432\u044B\u0438\u0433\u0440\u0430\u043B!\r\n\u041E\u043D\u0430 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439 \u0438 \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u0440\u044F\u0434\u043E\u043C \u0441 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u043C.\r\n\r\n\u0422\u0430\u0439\u043C\u0435\u0440:\r\n\u2022 35 \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0443\r\n\u2022 \u0412\u0440\u0435\u043C\u044F \u0432\u044B\u0448\u043B\u043E \u2014 \u043A\u043B\u0435\u0448\u043D\u044F \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F\r\n\u2022 \u041E\u0434\u043D\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0437\u0430 \u0438\u0433\u0440\u0443\r\n\r\n\u0427\u0442\u043E\u0431\u044B \u0441\u044B\u0433\u0440\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430 \u2014 \u043F\u043E\u043F\u043E\u043B\u043D\u0438 \u0431\u0430\u043B\u0430\u043D\u0441 \u0438 \u043D\u0430\u0436\u043C\u0438 \u043A\u0440\u0430\u0441\u043D\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443."
  titleText: {fileID: 1053297763}
  bodyText: {fileID: 1197823121}
